<% title 'Enterprise account', @enterprise_account.name %>
<% content_for :enterprise_page_title, 'Account' %>

<div class="enterprise-page enterprise-settings-page">
  <header class="enterprise-page-header enterprise-page-header-compact">
    <div>
      <span class="enterprise-eyebrow">Workspace management</span>
      <h1>Account</h1>
      <p>Review your organization details, plan, and payment status.</p>
    </div>
  </header>

  <section id="account" class="enterprise-settings-section">
    <header class="enterprise-section-heading">
      <div>
        <span class="enterprise-card-kicker">Organization</span>
        <h2>Enterprise account</h2>
      </div>
    </header>

    <div class="enterprise-settings-grid">
      <article class="enterprise-card enterprise-settings-card">
        <header class="enterprise-card-header">
          <h3>Enterprise data</h3>
        </header>
        <dl class="enterprise-account-details enterprise-detail-list">
          <div>
            <dt>Company name</dt>
            <dd><%= @enterprise_account.name %></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><%= @enterprise_account.applicant_email.presence || current_user.email %></dd>
          </div>
          <div>
            <dt>Company contact information</dt>
            <dd><%= simple_format(@enterprise_account.company_contact_information.presence || 'Not provided') %></dd>
          </div>
          <div>
            <dt>Representative contact information</dt>
            <dd><%= simple_format(@enterprise_account.representative_contact_information.presence || 'Not provided') %></dd>
          </div>
        </dl>
      </article>

      <article class="enterprise-card enterprise-settings-card enterprise-plan-card">
        <header class="enterprise-card-header">
          <h3>Plan</h3>
          <span class="enterprise-status-badge <%= @enterprise_account.pro? ? 'is-success' : 'is-neutral' %>">
            <%= @enterprise_account.plan.titleize %>
          </span>
        </header>

        <p class="enterprise-plan">
          Your plan: <strong><%= @enterprise_account.plan.titleize %></strong>
        </p>

        <% if @enterprise_account.pro? %>
          <dl class="enterprise-plan-details">
            <div>
              <dt>Payment method</dt>
              <dd class="enterprise-plan-payment-method"><%= @enterprise_account.payment_method_label.presence || 'Not recorded' %></dd>
            </div>
            <div>
              <dt>Access</dt>
              <dd class="enterprise-plan-active-until">
                <% if @enterprise_account.paid_until.present? %>
                  Your Pro access is active until <%= @enterprise_account.paid_until.to_fs(:simple) %>
                <% else %>
                  Your Pro access is active
                <% end %>
              </dd>
            </div>
          </dl>
        <% else %>
          <% status_visible = @enterprise_account.payment_method.present? ||
                              @pending_payment.present? ||
                              @enterprise_account.paid_until.present? %>
          <% payment_selectable = @pending_payment.blank? &&
                                  @enterprise_account.payment_method != 'invoice' %>

          <% if status_visible %>
            <%= render(
                  'enterprise/settings/account_status',
                  enterprise_account: @enterprise_account,
                  pending_payment: @pending_payment
                ) %>
          <% end %>

          <% if payment_selectable %>
            <section class="enterprise-get-pro">
              <h4>Upgrade to Enterprise Pro</h4>
              <p>
                Unlock domain monitoring, full matching URLs, API access, and reports for
                <strong><%= enterprise_pro_price %> per month</strong>.
              </p>

              <%= form_with url: enterprise_pay_path, method: :post, local: true do |form| %>
                <div class="enterprise-payment-options">
                  <% EnterpriseAccount::PAYMENT_METHOD_OPTIONS.each do |label, value| %>
                    <label class="enterprise-radio-card">
                      <%= form.radio_button :payment_method, value, required: true %>
                      <span>
                        <strong><%= label %></strong>
                        <small><%= value == 'credit_card' ? 'Activate through Stripe' : 'We will follow up by email' %></small>
                      </span>
                    </label>
                  <% end %>
                </div>
                <p class="form-text">
                  Card access activates after payment confirmation. Invoice access activates once the invoice is paid.
                </p>
                <%= form.submit 'Get Pro', class: 'enterprise-button enterprise-button-primary' %>
              <% end %>
            </section>
          <% end %>
        <% end %>
      </article>
    </div>
  </section>
</div>
