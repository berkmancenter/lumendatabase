<% title 'Enterprise notices', @enterprise_account.name %>
<% content_for :enterprise_page_title, 'Notices' %>

<div class="enterprise-page enterprise-notice-search">
  <header class="enterprise-page-header enterprise-page-header-compact">
    <div>
      <span class="enterprise-eyebrow">Domain monitoring</span>
      <h1>Notices</h1>
      <p>Search notices containing URLs on your verified domains.</p>
    </div>
  </header>

  <section class="enterprise-search-panel">
    <div class="enterprise-search-basic">
      <%= render 'shared/search' %>
    </div>

    <%= form_tag(@search_index_path, method: :get, class: 'enterprise-advanced-search-form') do %>
      <div class="container advanced-search">
        <div class="width-wrapper">
          <h5>Advanced search</h5>
          <% @searchable_fields.each do |field| %>
            <%= render field %>
          <% end %>
          <a id="duplicate-field" href="javascript:void(0);" class="add-group">Add another field</a>
          <div class="resubmit">
            <button class="enterprise-button enterprise-button-primary adv-search-submit" type="submit">Search notices</button>
          </div>
        </div>
      </div>
      <%= hidden_field_tag(:sort_by, params[:sort_by], class: 'sort_by_field', id: nil) %>
    <% end %>
  </section>

  <%= cache_unless(Current.user&.role?(:super_admin), @searcher.cache_key) do %>
    <section class="search-results enterprise-search-results">
      <header class="enterprise-results-header">
        <%= form_tag(@search_index_path, method: :get, id: 'facets-form') do %>
          <ol class="results-facets">
            <li class="enterprise-filter-label">Filter by</li>
            <% @filterable_fields.each do |filterable_field| %>
              <% unless filterable_field.skip_frontend %>
                <%= render filterable_field, results: @searchdata.response['aggregations'] %>
              <% end %>
            <% end %>
          </ol>
          <%= hidden_field_tag(:sort_by, params[:sort_by], class: 'sort_by_field', id: nil) %>
          <%= hidden_field_tag('term-exact-search', params['term-exact-search'], class: 'term-exact-search-adv', id: nil) %>
        <% end %>

        <div class="enterprise-results-toolbar">
          <span class="total-entries">
            <%= format(Translation.t('search_index_found'), total: @searchdata.results.total).html_safe %>
          </span>
          <div class="dropdown sort-order">
            <span>Sort:</span>
            <a class="dropdown-toggle" data-toggle="dropdown" href="javascript:void(0)">
              <%= sort_order_label(params[:sort_by], @model_class) %>
            </a>
            <ol class="dropdown-menu" role="menu">
              <% @ordering_options.each do |ordering| %>
                <li class="facet">
                  <%= link_to ordering.label,
                              '#',
                              'data-value': ordering.param,
                              'data-label': ordering.label %>
                </li>
              <% end %>
            </ol>
          </div>
        </div>
      </header>

      <% if @wrapped_instances.any? %>
        <ol class="results-list enterprise-results-list">
          <%= render partial: 'enterprise/notices/search/result', collection: @wrapped_instances %>
        </ol>
        <%= paginate @searchdata.results, left: 9, right: 2, current_page: @searcher.page.to_i %>
      <% else %>
        <div class="enterprise-empty-state enterprise-search-empty-state">
          <div class="enterprise-empty-icon">
            <svg aria-hidden="true"><use href="#enterprise-icon-search"></use></svg>
          </div>
          <h3>No notices found</h3>
          <p>Try a different search term or clear one of the active filters.</p>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<script type="text/javascript">
  facet_search_index_path = '<%= @facet_search_index_path %>';
  loader_url = '<%= image_url("loader.gif") %>';
</script>
