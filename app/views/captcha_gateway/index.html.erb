<% title 'Are you a human?' %>

<article class="captcha-gateway">
  <section class="body">
    <div class="main">
      <%= Translation.t('captcha_gateway_info') %>

      <%= form_tag(captcha_gateway_index_path, method: :post, id: 'captcha-gateway-form') do %>
        <%= hidden_field_tag :destination, params[:destination] %>

        <div class="form-inputs">
          <%= recaptcha_tags %>
        </div>

        <div class="form-actions">
          <input type="submit" name="commit" value="Submit">
        </div>
      <% end %>
    </div>
  </section>
</article>
